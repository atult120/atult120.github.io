---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} noindex={post.data.draft}>
  <article class="article">
    <a class="back" href="/blog">← Writing</a>
    {post.data.draft && <p class="draft-flag">Draft outline</p>}
    <h1>{post.data.title}</h1>
    <p class="post-date" style="margin-top:16px">
      {
        post.data.date.toLocaleDateString('en-IN', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })
      }
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
