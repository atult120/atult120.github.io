---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page is not on this site." noindex>
  <article class="article">
    <p class="kicker">404</p>
    <h1>This page is not here.</h1>
    <p class="note">The link may be old. The work, the resume, and the notes are still on the home page.</p>
    <div class="footer-actions">
      <a class="btn btn-primary" href="/">Back home</a>
    </div>
  </article>
</Base>
