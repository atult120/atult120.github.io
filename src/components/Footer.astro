---
import { site } from '../data/site';
---

<footer class="site-footer" id="contact">
  <h2 class="footer-title">Let's build something reliable.</h2>
  <div class="footer-actions">
    <a class="btn btn-accent" href={site.linkedin} rel="noopener noreferrer">Connect on LinkedIn</a>
    <a class="btn btn-outline" href={site.resumePath} download={site.resumeFilename}>Resume (PDF)</a>
  </div>
  <div class="foot-meta">
    <span>Atul Tiwari · Mumbai, Maharashtra, India</span>
    <span>Backend Engineering · Tech Leadership · <a href="/blog">Writing</a></span>
  </div>
</footer>
